[Unit]
Description=WGM WireGuard manager daemon
Documentation=https://github.com/cmerk2021/wgm
# The boot-time kill switch restore must run first so protection is in place
# before any network comes up, independent of this daemon.
Wants=wgm-killswitch.service
After=wgm-killswitch.service network.target nftables.service firewalld.service
RequiresMountsFor=/var/lib/wgm

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/wgmd
# Stopping the daemon never removes the kill switch; see docs/KILLSWITCH.md.
KillMode=mixed
TimeoutStopSec=30
Restart=on-failure
RestartSec=2s

RuntimeDirectory=wgmd
RuntimeDirectoryMode=0755
StateDirectory=wgm
StateDirectoryMode=0700
ConfigurationDirectory=wgm
ConfigurationDirectoryMode=0700
UMask=0077

# Hardening that is compatible with wg-quick, ip, nft and netlink.
# /etc stays writable because wg-quick may update DNS via resolvconf.
NoNewPrivileges=yes
ProtectSystem=true
ProtectHome=yes
PrivateTmp=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_CHOWN CAP_FOWNER CAP_SYS_MODULE

[Install]
WantedBy=multi-user.target
